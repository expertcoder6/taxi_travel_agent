# OpenAI API Configuration (Required for conversational slot-filling agent)
OPENAI_API_KEY=

# Groq API Configuration (Required for Whisper STT in voice calls)
GROQ_API_KEY=

# Twilio Configuration (For live Voice & SMS channels)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Configuration (Path to service account JSON for FCM)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Database
DATABASE_URL=sqlite:///./ride_booking.db
